{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/check-plan.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/check-tdd.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/remind-handoff.sh"
          },
          {
            "type": "command",
            "command": ".claude/hooks/remind-archive.sh"
          }
        ]
      }
    ]
  }
}
